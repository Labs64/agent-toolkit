#!/usr/bin/env bash
# Checks that the repository and environment can run a review of a branch, and
# prints one line per check. Exit code: 0 all fine, 1 warnings only, 2 a blocker.
set -uo pipefail

usage() {
    cat >&2 <<'USAGE'
Usage: preflight --target BRANCH [--base BRANCH] [--ticket ID] [--repo DIR] [--no-fetch]

  --target BRANCH  the branch to review
  --base BRANCH    the branch it merges into (default: the remote's default branch)
  --ticket ID      the ticket the branch belongs to, checked against the branch
  --repo DIR       the repository (default: the one containing the current directory)
  --no-fetch       skip fetching the refs from origin
USAGE
    exit 2
}

repo=. target= base= ticket= fetch=1
while (($#)); do
    case $1 in
        --target) target=$2; shift 2 ;;
        --base) base=$2; shift 2 ;;
        --ticket) ticket=$2; shift 2 ;;
        --repo) repo=$2; shift 2 ;;
        --no-fetch) fetch=0; shift ;;
        *) usage ;;
    esac
done
[[ -n $target ]] || usage

worst=0
report() { # level check message
    printf '%-5s %-22s %s\n' "$1" "$2" "$3"
    case $1 in
        WARN) ((worst < 1)) && worst=1 ;;
        FAIL) worst=2 ;;
    esac
}

top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || {
    report FAIL repository "$repo is not inside a git repository"
    exit 2
}
report OK repository "$top"
cd "$top" || exit 2

if [[ -z $base ]]; then
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    base=${base#origin/}
    if [[ -z $base ]]; then
        for candidate in main master; do
            if git rev-parse --verify --quiet "refs/remotes/origin/$candidate" >/dev/null; then
                base=$candidate
                break
            fi
        done
    fi
    [[ -n $base ]] || base=main
    report INFO "base default" "$base (the remote's default branch)"
fi

head_ref=$(git rev-parse --abbrev-ref HEAD)
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
    report INFO checkout "on $head_ref, with uncommitted changes; it stays untouched"
else
    report INFO checkout "on $head_ref, clean; it stays untouched"
fi

# A ref may exist only locally (pushed into this clone) or only on origin. The base
# is taken from origin, where it is current; the branch from the clone, where the
# author may push it.
fetch_ref() {
    if ((fetch)) && git ls-remote --exit-code --heads origin "$1" >/dev/null 2>&1; then
        git fetch -q origin "$1" 2>/dev/null
    fi
}
pick() { # name prefix... -> prints the first of refs/<prefix><name> that exists, or nothing
    local name=$1 prefix
    shift
    for prefix; do
        if git rev-parse --verify --quiet "refs/$prefix$name" >/dev/null; then
            printf '%s' "${prefix#heads/}$name" | sed 's#^remotes/##'
            return
        fi
    done
}

fetch_ref "$base"
fetch_ref "$target"
base_ref=$(pick "$base" remotes/origin/ heads/)
target_ref=$(pick "$target" heads/ remotes/origin/)
if [[ -z $base_ref ]]; then
    report FAIL "base branch" "$base exists neither on origin nor locally"
fi
if [[ -z $target_ref ]]; then
    report FAIL "target branch" "$target exists neither locally nor on origin"
fi
if [[ -n $base_ref && -n $target_ref ]]; then
    report OK "base branch" "$base_ref at $(git rev-parse --short "$base_ref")"
    if [[ $base_ref != "$base" ]] && git rev-parse --verify --quiet "refs/heads/$base" >/dev/null &&
        [[ $(git rev-parse "$base") != $(git rev-parse "$base_ref") ]]; then
        report INFO "local base" "$base is at $(git rev-parse --short "$base"), not at $base_ref"
    fi
    if [[ $target_ref == "$target" ]] && git rev-parse --verify --quiet "refs/remotes/origin/$target" >/dev/null &&
        [[ $(git rev-parse "$target") != $(git rev-parse "origin/$target") ]]; then
        report WARN "target branch" "$target ($(git rev-parse --short "$target")) differs from origin/$target ($(git rev-parse --short "origin/$target")); review the one the PR shows"
    fi
    count=$(git rev-list --count "$base_ref..$target_ref")
    merge_base=$(git merge-base "$base_ref" "$target_ref")
    if [[ $merge_base == $(git rev-parse "$base_ref") ]]; then
        report OK "target branch" "$target_ref at $(git rev-parse --short "$target_ref"), $count commits on top of $base_ref"
    else
        behind=$(git rev-list --count "$target_ref..$base_ref")
        report WARN "target branch" "$target_ref has $count commits, and is $behind behind $base_ref; findings may be stale"
    fi
    last=$(git reflog -1 --date=iso --format='%gd %gs' "$target_ref" 2>/dev/null)
    [[ -n $last ]] && report INFO "last update" "$last"
fi

if [[ -n $ticket && -n $base_ref && -n $target_ref ]]; then
    if git log --format='%s%n%b' "$base_ref..$target_ref" | grep -q "$ticket" || [[ $target == *"$ticket"* ]]; then
        report OK ticket "$ticket appears on the branch"
    else
        report WARN ticket "$ticket appears in no commit or branch name of the branch"
    fi
fi

# The host of the pull or merge request, from the origin URL.
origin_url=$(git remote get-url origin 2>/dev/null)
case $origin_url in
    *github.com*) host=github cli=gh ;;
    *gitlab*) host=gitlab cli=glab ;;
    *) host= cli= ;;
esac
if [[ -z $host ]]; then
    report INFO "host" "origin is ${origin_url:-not set}; PR lookups skipped"
elif ! command -v "$cli" >/dev/null; then
    report WARN "$cli" "not on PATH; PR comments, reviews and checks cannot be read"
elif ! "$cli" auth status >/dev/null 2>&1; then
    report WARN "$cli auth" "not logged in; PR lookups will fail"
elif [[ $host == github ]]; then
    pr=$(gh pr list --head "$target" --state all --json number,state,headRefOid \
        --jq '.[0] | select(.) | "#\(.number) \(.state) head \(.headRefOid[0:9])"' 2>/dev/null)
    if [[ -z $pr ]]; then
        report INFO "pull request" "none found for $target"
    else
        report OK "pull request" "$pr"
        pr_head=${pr##* }
        if [[ -n $target_ref ]] && [[ $(git rev-parse --short=9 "$target_ref") != "$pr_head" ]]; then
            report WARN "pull request" "its head $pr_head differs from $target_ref; review the PR head"
        fi
    fi
else
    mr=$(glab mr list --source-branch "$target" 2>/dev/null | head -1)
    report INFO "merge request" "${mr:-none found for $target}"
fi

# Checkout filters, such as git-crypt or LFS: a worktree checkout runs them and can
# fail, for example when a decryption key is not available to it. The review then
# exports the commit without these paths. Project tooling is left to the project.
filtered=$(git ls-files 2>/dev/null | git check-attr --stdin filter 2>/dev/null |
    awk -F': ' '$3 != "unspecified" && $3 != "unset" { split($1, p, "/"); print $3 " " p[1] }' |
    sort -u | awk '{ a[$1] = a[$1] (a[$1] ? "," : "") $2 } END { for (f in a) printf "%s in %s; ", f, a[f] }')
if [[ -n $filtered ]]; then
    report WARN "checkout filters" "${filtered%; }; if 'git worktree add' fails, use git archive excluding these paths"
else
    report OK "checkout filters" "none"
fi

for cli in python3 jq; do
    if command -v "$cli" >/dev/null; then
        report OK "$cli" "$(command -v "$cli")"
    else
        case $cli in
            python3) report FAIL "$cli" "not on PATH; the validator runs with it" ;;
            jq) report WARN "$cli" "not on PATH; a resumed session cannot extract single issues" ;;
        esac
    fi
done

exit "$worst"
